{
  "name": "asterion-256",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental, unaudited 256-bit ARX sponge-style hash research construction.",
  "type": "module",
  "main": "./dist/Asterion-256.js",
  "module": "./dist/Asterion-256.js",
  "types": "./dist/Asterion-256.d.ts",
  "exports": {
    ".": {
      "types": "./dist/Asterion-256.d.ts",
      "import": "./dist/Asterion-256.js"
    },
    "./package.json": "./package.json"
  },
  "files": [
    "dist",
    "SPEC.md",
    "DESIGN.md",
    "README.md",
    "LICENSE"
  ],
  "license": "Apache-2.0",
  "author": "Mihir9702",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mihir9702/Asterion-256.git"
  },
  "keywords": [
    "cryptography",
    "hash",
    "arx",
    "sponge",
    "research",
    "experimental"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node tests/asterion.test.mjs && node tests/statistical_smoke.test.mjs && node tests/security_lifecycle.test.mjs",
    "test:reference": "python reference/verify_vectors.py",
    "test:analysis": "python analysis/run_suite.py --quick",
    "test:analysis:full": "python analysis/run_suite.py --full",
    "bench": "npm run build && node benchmarks/bench.mjs",
    "verify": "npm run typecheck && npm test && npm run test:reference && npm run test:analysis"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
