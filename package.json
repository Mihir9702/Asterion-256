{
  "name": "asterion-256",
  "version": "0.1.0",
  "private": true,
  "description": "Experimental, unaudited 256-bit ARX sponge-style hash research construction.",
  "type": "module",
  "license": "Apache-2.0",
  "author": "Mihir9702",
  "repository": {
    "type": "git",
    "url": "https://github.com/Mihir9702/Asterion-256.git"
  },
  "keywords": [
    "cryptography",
    "hash",
    "arx",
    "sponge",
    "research",
    "experimental"
  ],
  "engines": {
    "node": ">=18"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "npm run build && node --test tests/*.test.mjs",
    "test:reference": "python reference/verify_vectors.py",
    "test:analysis": "python analysis/run_suite.py --quick",
    "test:analysis:full": "python analysis/run_suite.py --full",
    "bench": "npm run build && node benchmarks/bench.mjs",
    "verify": "npm run typecheck && npm test && npm run test:reference && npm run test:analysis"
  },
  "devDependencies": {
    "typescript": "^5.9.3"
  }
}
